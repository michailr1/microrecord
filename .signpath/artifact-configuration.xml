<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy of the SignPath artifact configuration for this project (the active one lives in SignPath).
  The signed artifact is the GitHub Actions artifact "unsigned-<version>" uploaded by
  .github/workflows/build.yml: a zip with the two single-file EXEs.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="MicroRecord-win-x64.exe" product-name="MicroRecord">
      <authenticode-sign />
    </pe-file>
    <pe-file path="MicroRecord-win-x64-net9.exe" product-name="MicroRecord">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
