<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MicroRecord</AssemblyName>
    <RootNamespace>MicroRecord</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>1.0.0</Version>
    <Product>MicroRecord</Product>
    <Description>Portable Windows meeting recorder: microphone + system audio to one file with a hotkey.</Description>
    <ApplicationIcon>Assets\MicroRecord.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="NAudio.Extras" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\MicroRecord.ico" LogicalName="MicroRecord.ico" />
    <EmbeddedResource Include="Assets\Recording.ico" LogicalName="Recording.ico" />
  </ItemGroup>
</Project>
