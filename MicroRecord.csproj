<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net9.0-windows: a windows10.x TFM would bundle the ~25 MB Windows SDK projection we don't use.
         Process loopback needs Windows 10 2004; that is checked at runtime (AudioSourceFactory.OpenProcessLoopback). -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Per-monitor DPI v2: windows (incl. toasts) render crisp instead of being bitmap-scaled by Windows. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MicroRecord</AssemblyName>
    <RootNamespace>MicroRecord</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained vs framework-dependent is chosen per publish (see .github/workflows/build.yml). -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>1.1.9</Version>
    <Product>MicroRecord</Product>
    <Description>Portable Windows meeting recorder: microphone + system audio to one file with a hotkey.</Description>
    <Copyright>Copyright (c) 2026 michailr1. MIT License.</Copyright>
    <ApplicationIcon>Assets\MicroRecord.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="NAudio.Extras" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\MicroRecord.ico" LogicalName="MicroRecord.ico" />
    <EmbeddedResource Include="Assets\Recording.ico" LogicalName="Recording.ico" />
  </ItemGroup>
</Project>
